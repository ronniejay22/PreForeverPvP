###################################################################################################
# PLAYERBOT CONFIG
###################################################################################################

[worldserver]

#    Playerbot.Enable
#        Description: Enables Playerbot systems.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.Enable = 0

#    Playerbot.PvpCore.Enable
#        Description: Enables Playerbot PvP core trigger/value scaffolding and battleground state detection.
#                     This phase only wires infrastructure and does not execute class spell logic.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.PvpCore.Enable = 0

#    Playerbot.PvpTactics.Enable
#        Description: Enables battleground tactical trigger/action selection plus primitive execution
#                     for waiting/active/often/low-health/low-mana/timer-bg flows, including
#                     objective-state flag-carrier pursuit/protection movement in WSG/EotS contexts.
#                     This remains default OFF and does not change queue policy or class rotation logic.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.PvpTactics.Enable = 0

#    Playerbot.PvpLifecycle.Enable
#        Description: Enables battleground/arena queue participation lifecycle scaffolding and random-bot
#                     participation hooks. Real players are always excluded from these hooks.
#                     Battleground queue primitive currently targets Warsong Gulch.
#                     This phase wires lifecycle entry points only and does not
#                     include class spell logic, queue cadence tuning, or SQL payloads.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.PvpLifecycle.Enable = 0

#    Playerbot.PvpLifecycle.PersistentBots.Enable
#        Description: Enables the queue/invite/in-progress PvP lifecycle for persistent
#                     account-backed random bots. Transient OBC/arena clones continue to use
#                     the PvP lifecycle when Playerbot.PvpLifecycle.Enable is enabled, even if
#                     this is 0. Set this to 0 when persistent bots should remain in the open
#                     world and only transient clones should fight instanced PvP.
#        Default: 1

Playerbot.PvpLifecycle.PersistentBots.Enable = 1

#    Playerbot.PvpLifecycle.QueueOnly.ScarletChapelAccounts
#    Playerbot.PvpLifecycle.QueueOnly.BlackrockThroneAccounts
#    Playerbot.PvpLifecycle.QueueOnly.BattleForGilneasAccounts
#    Playerbot.PvpLifecycle.QueueOnly.TwinPeaksAccounts
#    Playerbot.PvpLifecycle.QueueOnly.ArathiBasinAccounts
#    Playerbot.PvpLifecycle.QueueOnly.WarsongGulchAccounts
#    Playerbot.PvpLifecycle.QueueOnly.ArenaAccounts
#        Description: Comma-separated account IDs for queue segmentation. Managed bots on these accounts
#                     are constrained to the corresponding queue family only.
#                     ArenaAccounts suppress battleground queue joins so those bots can queue arena only.
#                     BlackrockThrone uses QueueOnly.BlackrockThroneBgTypeId for its battleground type ID.
#        Default:     "" (empty list)

Playerbot.PvpLifecycle.QueueOnly.ScarletChapelAccounts =
Playerbot.PvpLifecycle.QueueOnly.BlackrockThroneAccounts =
Playerbot.PvpLifecycle.QueueOnly.BattleForGilneasAccounts =
Playerbot.PvpLifecycle.QueueOnly.TwinPeaksAccounts =
Playerbot.PvpLifecycle.QueueOnly.ArathiBasinAccounts =
Playerbot.PvpLifecycle.QueueOnly.WarsongGulchAccounts =
Playerbot.PvpLifecycle.QueueOnly.ArenaAccounts =

#    Playerbot.PvpLifecycle.QueueOnly.BlackrockThroneBgTypeId
#        Description: Battleground type ID used for Playerbot.PvpLifecycle.QueueOnly.BlackrockThroneAccounts.
#                     Set this to your custom Blackrock Throne battleground type ID.
#        Default:     0 (disabled; accounts in BlackrockThroneAccounts fall back to other configured rules)

Playerbot.PvpLifecycle.QueueOnly.BlackrockThroneBgTypeId = 0

#    Playerbot.PvpLifecycle.ObsidianColosseum.Clone.Enable
#        Description: Creates transient "Dark <name>" player clones entirely in memory when a real
#                     player enters Obsidian Colosseum. No account or character database rows are used.
#                     The legacy CloneAccountId setting is accepted only as an enable/disable fallback;
#                     its numeric value is never used as an account ID.
#        Default:     0 (disabled)

Playerbot.PvpLifecycle.ObsidianColosseum.Clone.Enable = 0

# Legacy enable fallback. Nonzero enables clones only when Clone.Enable is absent.
Playerbot.PvpLifecycle.ObsidianColosseum.CloneAccountId = 0

#    Playerbot.Pvp.GuildName
#        Description: Guild worn by every transient PvP copy - battleground fill, custom games,
#                     the Obsidian Colosseum "Dark <name>" mirrors, the lobby mannequins and the
#                     open-world bounty hunters - so a person fighting one can tell it apart from
#                     a real player at a glance. A copy has no character row and is never a real
#                     member: it carries the guild's id and the client resolves the name from it.
#                     The PvP-only characters behind the copies (Playerbot.Pve.PvpOnlyAccountIds)
#                     ARE joined for real, which is what gives the guild its master and roster;
#                     the first of them founds it. Empty disables the whole behaviour. Nothing is
#                     created while no PvP-only account is configured.
#        Default:     The Robot Masters

Playerbot.Pvp.GuildName = "The Robot Masters"

###################################################################################################
# PLAYERBOT BATTLEGROUND FILL (TRANSIENT CLONES)
#
#    Pads public battlegrounds and unrated arena skirmishes with in-memory copies of the managed
#    playerbots instead of pulling the bots themselves out of the world. A real player who queues
#    alone gets a match after a short wait; both teams are then filled with clones matched to the
#    bracket's level range. Rated arenas are filled only where Playerbot.BgFill.RatedArena.Enable
#    says so (below).
#    The clones step aside one at a time as more real players are invited, refill seats people
#    leave, and are gone once the last real player is. The resource governor above applies to
#    them as it does to custom-game bots.
###################################################################################################

#    Playerbot.BgFill.Enable
#        Description: Master switch. Needs Playerbot.Enable and the PvP modules for the clones
#                     to fight.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.BgFill.Enable = 0

#    Playerbot.BgFill.BattlegroundTypes
#        Description: Comma-separated battleground type IDs to fill (2 Warsong Gulch, 3 Arathi
#                     Basin, 7 Eye of the Storm, 30 Isle of Conquest, 32 Random Battleground,
#                     100 Scarlet Chapel, 108 Twin Peaks, 120 Battle for Gilneas, ...).
#                     Empty = every battleground except Violet Hold, whose enemies come in waves
#                     of its own. Arena skirmishes are controlled separately below.
#        Default:     "" (all battlegrounds)

Playerbot.BgFill.BattlegroundTypes = ""

#    Playerbot.BgFill.QueueWaitSeconds
#        Description: How long the longest-waiting real player sits in a queue that cannot form
#                     a stock match before a clone-filled one is started for everyone waiting
#                     in that bracket. Gives other people a moment to queue into the same pop.
#                     The queue is only re-examined every few seconds, so treat this as a floor.
#        Default:     15

Playerbot.BgFill.QueueWaitSeconds = 15

#    Playerbot.BgFill.SkirmishArena.Enable
#        Description: Fill unrated arena skirmishes with the same transient bot clones used by
#                     battleground fill. Rated arenas have their own switch below.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Playerbot.BgFill.SkirmishArena.Enable = 1

#    Playerbot.BgFill.SkirmishArena.QueueWaitSeconds
#        Description: How long a real player must wait in an unrated arena queue before a
#                     clone-filled skirmish is created. Independent of the battleground wait.
#                     0 pops the skirmish as soon as the queue is examined, which is still
#                     after the stock rules have had their go at forming a match out of the
#                     people already waiting.
#        Default:     0

Playerbot.BgFill.SkirmishArena.QueueWaitSeconds = 0

#    Playerbot.BgFill.SkirmishArena.HealersPerTeam
#    Playerbot.BgFill.SkirmishArena.HealersPerTeamOfFive
#        Description: Healers each side of a clone-filled skirmish ends up with - each squad in
#                     Four Corners, each side of a Buffle Shuffle's first round - counting the
#                     people already there. HealersPerTeam is for teams of two to four,
#                     HealersPerTeamOfFive for teams of five. A healer is anyone with most
#                     talent points in a healing tree, as Buffle Shuffle judges it. Where the
#                     bracket has too few healer bots, both sides get the same lower number.
#                     0 deals clones by class variety alone.
#        Default:     1, 2

Playerbot.BgFill.SkirmishArena.HealersPerTeam = 1
Playerbot.BgFill.SkirmishArena.HealersPerTeamOfFive = 2

#    Playerbot.BgFill.RatedArena.Enable
#        Description: Rated 2v2, 3v3, 4v4 and 5v5 played the way skirmishes are: queued alone or
#                     by a party smaller than the arena, and made up with clones. Real arena teams
#                     are still paired with each other first, as stock - two short teams included,
#                     each topped up with clones. A team the queue finds no real opponent for in
#                     RatedArena.QueueWaitSeconds plays clones instead, and the clones count as an
#                     opponent of the team's own matchmaker rating: a win or a loss moves its team
#                     rating, matchmaker rating and personal ratings exactly as one against an
#                     even team would (about 12 points at the stock modifiers), and arena points
#                     follow from that as usual. Nothing is rated when no clone could be found to
#                     fight. The last person leaving a side forfeits for it. Healers are dealt by
#                     SkirmishArena.HealersPerTeam*. "Arena bots" in the Battlegrounds tab still
#                     keeps a character out of clone-filled matches, rated ones included.
#                     The arena window's rated rows are told whether this is on (CCGAME
#                     ARENARATED) and can only be joined alone or short-handed while it is.
#                     Four Corners and Buffle Shuffle are not affected.
#        Default:     0 - (Disabled, rated arenas are stock: whole teams against whole teams)
#                     1 - (Enabled)

Playerbot.BgFill.RatedArena.Enable = 0

#    Playerbot.BgFill.RatedArena.QueueWaitSeconds
#        Description: How long a rated team waits for a real opponent before it is given clones.
#                     0 gives it clones as soon as the queue is examined, which leaves two real
#                     teams that queue a few seconds apart almost no chance to meet.
#        Default:     30

Playerbot.BgFill.RatedArena.QueueWaitSeconds = 30

#    Playerbot.BgFill.RatedArena.AutoCreateTeam
#        Description: A character queueing rated alone with no arena team of that size is made a
#                     team of one, named "<Name> 2v2" (numbered, should the name be taken), and
#                     queued in it - at the level a charter asks for, the realm's maximum. A party
#                     is never given a team: its leader's team is used, as stock, and every member
#                     has to be in it.
#        Default:     1 - (Enabled)
#                     0 - (Disabled, a team comes from a charter or `.arena create` as stock)

Playerbot.BgFill.RatedArena.AutoCreateTeam = 1

#    Playerbot.BgFill.RatedArena.Ladder.Enable
#        Description: A ladder of bot arena teams. Arena teams are made of the level-cap characters
#                     on Playerbot.Pve.PvpOnlyAccountIds, and a rated team the queue gives clones
#                     to plays one of them instead of nameless clones: one of the three nearest its
#                     matchmaker rating, at random, and not the one it played last while there is
#                     anybody else, so the opponents rotate. The clones on that side are copies of
#                     that team's members, and both teams are rated. The teams start at the same
#                     rating as anybody else and play each other on paper between real games
#                     (Ladder.SimulateMinutes). A ladder team is any arena team whose captain is one
#                     of those characters; teams are only ever added, so turning this off just stops
#                     the queue from using them. `.arena ladder [2|3|4|5]` shows the standings.
#                     Needs RatedArena.Enable.
#        Default:     0 - (Disabled, rated teams play nameless clones)
#                     1 - (Enabled)

Playerbot.BgFill.RatedArena.Ladder.Enable = 0

#    Playerbot.BgFill.RatedArena.Ladder.Teams2v2
#    Playerbot.BgFill.RatedArena.Ladder.Teams3v3
#    Playerbot.BgFill.RatedArena.Ladder.Teams4v4
#    Playerbot.BgFill.RatedArena.Ladder.Teams5v5
#        Description: Teams of each size the ladder keeps. Missing ones are made at startup and on
#                     .reload config, each with the healers SkirmishArena.HealersPerTeam* asks for
#                     and every class once while there is a choice. A character is on one team of a
#                     size at most, so the number of level-cap PvP-only bots caps each size.
#        Default:     12, 9, 6, 6

Playerbot.BgFill.RatedArena.Ladder.Teams2v2 = 12
Playerbot.BgFill.RatedArena.Ladder.Teams3v3 = 9
Playerbot.BgFill.RatedArena.Ladder.Teams4v4 = 6
Playerbot.BgFill.RatedArena.Ladder.Teams5v5 = 6

#    Playerbot.BgFill.RatedArena.Ladder.SimulateMinutes
#        Description: Every this many minutes each size plays one game on paper: a ladder team at
#                     random against one of the three nearest it, neither of them in a real match.
#                     The winner is rolled from the stock Elo chance on their matchmaker ratings,
#                     with a team of the hard tier (Playerbot.BgFill.Tier.*) counted 150 above its
#                     rating and one of the easy tier 150 below, so the stronger rosters climb. Both
#                     teams and their members are rated as a real game would rate them.
#        Default:     5
#                     0 - (the ladder's teams only play rated teams)

Playerbot.BgFill.RatedArena.Ladder.SimulateMinutes = 5

#    Playerbot.BgFill.MaxPerTeam
#        Description: Team size the clones fill up to, capped by the battleground's own maximum
#                     (so 10 for Warsong Gulch whatever this says). Real players are always
#                     admitted up to the battleground's maximum regardless. 0 = the
#                     battleground's maximum.
#        Default:     15

Playerbot.BgFill.MaxPerTeam = 15

#    Playerbot.BgFill.ClonesPerTick
#        Description: Clones created per match per half-second tick while a team is short.
#                     Spreads the cost of building copies over a few ticks.
#        Default:     2

Playerbot.BgFill.ClonesPerTick = 2

#    Playerbot.BgFill.UseOfflineBots
#        Description: When no online managed bot fits the bracket, copy offline characters from
#                     the bot accounts (loaded from the database in the background). Keeps low
#                     brackets fillable when the online population is levelled past them.
#        Default:     1

Playerbot.BgFill.UseOfflineBots = 1

#    Playerbot.BgFill.AllowHumanMirrors
#        Description: Last resort when no bot fits the bracket at all: seat a "Dark <name>" copy
#                     of a real participant on the opposing team, one per person.
#        Default:     1

Playerbot.BgFill.AllowHumanMirrors = 1

#    Playerbot.BgFill.DuplicateSources.MinTeamSize
#        Description: A battleground (never an arena) whose template seats at least this many a
#                     side may deal the same character in more than once, once every character
#                     in the bracket's pool is already in the match. Each side repeats a name only
#                     after all of the pool is on it. The level-60 pool is the PvP-only accounts
#                     (27 characters), so without this Alterac Valley and Isle of Conquest stop
#                     near 13 a side. Such a battleground also fills up to
#                     Playerbot.BgFill.DuplicateSources.MaxPerTeam instead of
#                     Playerbot.BgFill.MaxPerTeam. 0 = never.
#        Default:     40
#
#    Playerbot.BgFill.DuplicateSources.MaxPerTeam
#        Description: Team size the clones fill up to in a battleground that allows duplicates,
#                     capped by the battleground's own maximum. 0 = the battleground's maximum.
#        Default:     0

Playerbot.BgFill.DuplicateSources.MinTeamSize = 40
Playerbot.BgFill.DuplicateSources.MaxPerTeam = 0

#    Playerbot.BgObjectives.SiegeVehicles
#        Description: Bots drive the siege vehicles a battleground offers (Strand of the Ancients'
#                     demolishers, Isle of Conquest's siege engines and demolishers) at the gate
#                     their team is breaking. Off: they carry charges instead, and a bot already in
#                     a vehicle climbs out. Picked up by .reload config.
#        Default:     1

Playerbot.BgObjectives.SiegeVehicles = 1

#    Playerbot.BgFill.Tier.Easy.Characters
#    Playerbot.BgFill.Tier.Medium.Characters
#    Playerbot.BgFill.Tier.Hard.Characters
#        Description: Difficulty tiers for the bots the fill copies: character guids,
#                     comma-separated, "first-last" for a range. A bot in no tier is dealt like
#                     any other. A guid listed in two tiers stays in the easier one.
#        Default:     "" (no tiers)

Playerbot.BgFill.Tier.Easy.Characters = ""
Playerbot.BgFill.Tier.Medium.Characters = ""
Playerbot.BgFill.Tier.Hard.Characters = ""

#    Playerbot.BgFill.Tier.Easy.BattlegroundTypes
#    Playerbot.BgFill.Tier.Medium.BattlegroundTypes
#    Playerbot.BgFill.Tier.Hard.BattlegroundTypes
#        Description: Battleground type IDs that belong to each tier (100 Scarlet Chapel,
#                     101 Blackrock Throne, 102 Obsidian Colosseum, ...). When one of these is
#                     filled, BOTH teams are dealt that tier's bots first, then the tier next
#                     to it, then the far one, then bots in no tier. A battleground in no tier
#                     draws its bots at random. An arena skirmish matches its own arena's
#                     type, or 6 for every arena.
#        Default:     "" (no tiers)

Playerbot.BgFill.Tier.Easy.BattlegroundTypes = ""
Playerbot.BgFill.Tier.Medium.BattlegroundTypes = ""
Playerbot.BgFill.Tier.Hard.BattlegroundTypes = ""

#    Playerbot.BgFill.ClassVariety.TeamPenalty
#    Playerbot.BgFill.ClassVariety.MatchPenalty
#        Description: Nudge the fill toward a mix of classes. Each seat is drawn at random
#                     from the best tier still available, and a bot's chance is divided by
#                     1 + TeamPenalty x (copies of its class already on that team)
#                       + MatchPenalty x (copies of its class anywhere in the match).
#                     The defaults make a class already on the team about five times less
#                     likely to be dealt again - rare, never impossible. Tier order is never
#                     broken. Arenas and untiered battlegrounds are nudged the same way.
#                     0 and 0 deal in plain tier order. Picked up by .reload config.
#        Default:     4 / 1

Playerbot.BgFill.ClassVariety.TeamPenalty = 4
Playerbot.BgFill.ClassVariety.MatchPenalty = 1

#    Playerbot.PvpClassSpells.Enable
#        Description: Enables Phase-4 class/spec PvP spell decision slices.
#                     Current implementation provides reference-aligned trigger/action vocabulary
#                     plus explicit ordered fallback alternates and strict cast-point validation
#                     (known rank, cooldown/GCD/cast state, resource cost, range/LOS, target validity).
#                     Feature remains default OFF.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.PvpClassSpells.Enable = 0

#    Playerbot.PvpClassSpells.Interrupt.ReactionMinMs
#    Playerbot.PvpClassSpells.Interrupt.ReactionMaxMs
#        Description: Humanized interrupt reflexes. Each bot has its own steady reaction time,
#                     somewhere in [Min, Max] milliseconds and fixed by its name, so the same
#                     bot kicks with the same timing every match and players can learn it.
#                     Its interrupt (Counterspell, Kick, Pummel, Earth Shock, Spell Lock,
#                     Scatter Shot, Hammer of Justice, Repentance, Rebuke, ...) goes out that
#                     long after it notices an enemy cast. Short casts can slip under a slow
#                     bot entirely. ReactionMaxMs = 0 restores the old instant-reflex
#                     behavior. Values are clamped to [0, 5000] and Max is raised to Min when
#                     configured lower.
#        Default:     200 (ReactionMinMs)
#                     1000 (ReactionMaxMs)

Playerbot.PvpClassSpells.Interrupt.ReactionMinMs = 200
Playerbot.PvpClassSpells.Interrupt.ReactionMaxMs = 1000

#    Playerbot.PvpClassSpells.Interrupt.JitterMs
#        Description: How far one cast's reaction may stray either side of the bot's steady
#                     time, in milliseconds. The result is kept inside [ReactionMinMs,
#                     ReactionMaxMs]. Keep it well under CommitWindowMs or a learned fake-out
#                     stops working reliably. Clamped to [0, 1000].
#        Default:     100

Playerbot.PvpClassSpells.Interrupt.JitterMs = 100

#    Playerbot.PvpClassSpells.Interrupt.CommitWindowMs
#        Description: Fake-cast bait window in milliseconds. Once a bot's reaction time
#                     arrives it has committed to pressing its interrupt: if the enemy cast
#                     disappears within this window immediately before that moment, the
#                     interrupt is fired anyway at the now-idle target and wasted. Cancelling
#                     earlier than the window makes the bot hold the interrupt instead.
#                     Larger values make bots easier to juke; 0 disables wasted presses
#                     entirely. Clamped to [0, 2000].
#        Default:     350

Playerbot.PvpClassSpells.Interrupt.CommitWindowMs = 350

#    Playerbot.PvpClassSpells.Interrupt.OffTargetExtraMs
#    Playerbot.PvpClassSpells.Interrupt.OffTargetNoticePct
#        Description: Attention. A bot reacts at full speed only to its own target. A caster
#                     it is not fighting is noticed only OffTargetNoticePct percent of the
#                     time (rolled once per cast), and OffTargetExtraMs later than its own
#                     target would be. While its own target is casting, it notices no one
#                     else. Clamped to [0, 5000] and [0, 100].
#        Default:     500 (OffTargetExtraMs)
#                     50 (OffTargetNoticePct)

Playerbot.PvpClassSpells.Interrupt.OffTargetExtraMs = 500
Playerbot.PvpClassSpells.Interrupt.OffTargetNoticePct = 50

#    Playerbot.PvpClassSpells.RehgarMovementDiagnostics
#        Description: Sends Rehgar's Fury movement diagnostics as server system messages
#                     to every online GM. Only switch this on while capturing a
#                     movement trace: it walks every session on the realm.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.PvpClassSpells.RehgarMovementDiagnostics = 0

#    Playerbot.RandomPopulation.Enable
#        Description: Enables random-bot population manager orchestration. When enabled and runtime started,
#                     periodic rebalance ticks evaluate online random-bot count (bots are always identified as
#                     explicit managed bot accounts from Playerbot.RandomPopulation.BotAccountIds and attempt
#                     server-side login/logout orchestration for those accounts/characters only.
#                     Real players are hard-excluded from all lifecycle and population automation.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.RandomPopulation.Enable = 0

#    Playerbot.RandomPopulation.TargetMin
#        Description: Minimum target number of online random bots maintained by the population manager.
#        Default:     0

Playerbot.RandomPopulation.TargetMin = 0

#    Playerbot.RandomPopulation.TargetMax
#        Description: Maximum target number of online random bots maintained by the population manager.
#                     If greater than TargetMin, rebalance deterministically rotates target in range.
#                     With DynamicWorldLoad on, zone guardians and veterans log in first and banded
#                     locals log out first, so a lower target sheds locals. Pin
#                     Playerbot.Pve.Rebirth.VeteranFleetSize before lowering it.
#        Default:     0

Playerbot.RandomPopulation.TargetMax = 0

#    Playerbot.RandomPopulation.RebalanceIntervalMs
#        Description: Rebalance cadence for population manager ticks in milliseconds.
#        Default:     15000 (15 seconds)

Playerbot.RandomPopulation.RebalanceIntervalMs = 15000

#    Playerbot.RandomPopulation.BotAccountIds
#        Description: Comma-separated account IDs reserved for random population bot pool selection.
#                     Only characters from these accounts are considered for offline pool candidate picks.
#                     This list is also the explicit managed identity boundary for lifecycle/login/logout:
#                     characters outside this list are always treated as real-player safety scope.
#                     Keep this list strictly bot-only to prevent selecting real-player characters.
#        Default:     "" (empty, no pool)

Playerbot.RandomPopulation.BotAccountIds =

#    Playerbot.RandomPopulation.MinLevel
#        Description: Minimum character level for offline pool selection.
#        Default:     10

Playerbot.RandomPopulation.MinLevel = 10

#    Playerbot.RandomPopulation.MaxLevel
#        Description: Maximum character level for offline pool selection.
#        Default:     80

Playerbot.RandomPopulation.MaxLevel = 80

#    Playerbot.RandomPopulation.AllianceRatioPercent
#        Description: Soft alliance percentage target used while selecting login candidates.
#                     50 means roughly even faction split over time.
#        Default:     50

Playerbot.RandomPopulation.AllianceRatioPercent = 50

#    Playerbot.RandomPopulation.MaxOnlineBotsPerAccount
#        Description: Maximum random bots allowed online at once per account during candidate selection.
#                     Set to 0 to disable the cap (allows multiple bots per account without manager-side limit).
#        Default:     0

Playerbot.RandomPopulation.MaxOnlineBotsPerAccount = 0

#    Playerbot.RandomPopulation.SelectionHistorySize
#        Description: Number of recently selected offline bot guids to deprioritize during deterministic
#                     candidate ordering to reduce immediate repeats while preserving reproducibility.
#        Default:     48

Playerbot.RandomPopulation.SelectionHistorySize = 48

#    Playerbot.RandomPopulation.DynamicWorldLoad.Enable
#        Description: Keep a fixed combined real-player plus persistent-bot world budget.
#                     The budget is TargetMin/TargetMax capped at the bots that can actually be
#                     online (online now plus offline characters allowed to log in), so each
#                     real player online removes one persistent bot and a logout restores one
#                     even when the configured target is larger than the bot roster.
#                     Zone changes prefer swapping ordinary local bots out of human-empty zones
#                     for locals assigned to zones containing humans.
#                     Starter bots are kept offline: local bots whose band home is a starter
#                     (1-10) zone and whose level is 10 or below, wherever they are standing.
#                     A higher-level bot passing through a starter zone is not a starter bot.
#                     Drifters, human companions, queued/matched bots, bots mid-teleport, and
#                     bots carrying unresolved player death-chest auction loot are never pruned.
#                     Characters waiting for a forced rename cannot log in and are skipped.
#                     Offline characters remain available to the transient BG/arena clone filler.
#                     Intended for Barracks+; leave disabled on Legionnaire+.
#        Default:     0

Playerbot.RandomPopulation.DynamicWorldLoad.Enable = 0

###################################################################################################
# RESOURCE GOVERNOR
#
#    Watches the average world update time and sheds custom-match bot load before the whole
#    server degrades. Matches with human PARTICIPANTS are never throttled or ended by the
#    governor; it only limits bot fill for custom games and, under sustained hard pressure,
#    ends bot-only matches (unwatched ones first, then spectator-only ones).
###################################################################################################

#    Playerbot.Governor.Enable
#        Description: Master switch for the resource governor.
#        Default:     1

Playerbot.Governor.Enable = 1

#    Playerbot.Governor.SoftUpdateTimeMs
#        Description: Average world update time (ms) above which the server is considered under
#                     soft pressure: new custom-match bot additions are capped at
#                     Playerbot.Governor.SoftMatchBotCap per match.
#        Default:     110

Playerbot.Governor.SoftUpdateTimeMs = 110

#    Playerbot.Governor.HardUpdateTimeMs
#        Description: Average world update time (ms) above which the server is under hard
#                     pressure: no new custom-match bots may be added, bot-only matches may not
#                     start, and sustained pressure culls running bot-only/spectator-only matches.
#        Default:     180

Playerbot.Governor.HardUpdateTimeMs = 180

#    Playerbot.Governor.HardSustainSeconds
#        Description: Hard pressure must persist this long before the first match is culled.
#        Default:     10

Playerbot.Governor.HardSustainSeconds = 10

#    Playerbot.Governor.CullCooldownSeconds
#        Description: Minimum time between two governor match culls, so the update-time average
#                     can settle after each shed before deciding again.
#        Default:     20

Playerbot.Governor.CullCooldownSeconds = 20

#    Playerbot.Governor.SoftMatchBotCap
#        Description: Maximum bots/clones a single custom match may request while under soft
#                     pressure. Has no effect at normal load.
#        Default:     20

Playerbot.Governor.SoftMatchBotCap = 20

#    Playerbot.Governor.MaxTotalCustomMatchBots
#        Description: Hard cap on bots/clones across all running custom matches plus the lobby
#                     roster being edited, regardless of update time. 0 disables the cap.
#        Default:     160

Playerbot.Governor.MaxTotalCustomMatchBots = 160

#    Playerbot.Governor.BotShedCooldownSeconds
#        Description: Once no cullable bot-only/spectator-only match remains but hard pressure
#                     persists, one bot is removed from the human-participant match with the
#                     largest bot roster every this many seconds (dead bots and the larger team
#                     are preferred) until the update-time average recovers.
#        Default:     5

Playerbot.Governor.BotShedCooldownSeconds = 5

#    Playerbot.PvpDecision.GlobalLock
#        Description: Diagnostic switch. 1 restores the old behavior of serializing every bot
#                     decision tick through one global mutex instead of one lock per map
#                     instance. Costs multi-battleground parallelism; use it to isolate whether
#                     a crash or corruption comes from cross-map bot concurrency.
#        Default:     0

Playerbot.PvpDecision.GlobalLock = 0

###################################################################################################
# PLAYERBOT PVE (COMPANIONS, LEVELING, GRINDING)
###################################################################################################

#    Playerbot.Pve.Enable
#        Description: Master switch for open-world PvE bot behavior: companion bots that follow,
#                     assist and level with a human, and (optionally) autonomous grinding for the
#                     idle random-bot population. Combat decisions reuse the PvP class-spell
#                     engine, so Playerbot.Enable and Playerbot.PvpClassSpells.Enable must also
#                     be on for bots to actually fight.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.Pve.Enable = 0

#    Playerbot.GoldGainMultiplier
#        Description: Multiplies gold a managed playerbot earns from world faucets, for bots
#                     ABOVE the low-level band (see Playerbot.GoldGainMultiplier.LowLevelMaxLevel).
#                     Monster loot and NPC-vendor payouts only: auction settlements, mail
#                     and quest rewards are all paid at face value, and losses are never
#                     scaled either, so bots still pay full price for gear, ammunition and
#                     food. Auction selling is excluded deliberately - scaling it would
#                     MINT gold, since a bot-to-bot sale would credit the seller more than
#                     it took from the buyer. NPC vendors have no player counterparty.
#                     A bot funds its entire economy out of what it earns and has no player
#                     behind it to subsidise a bad run, so at 1.0 the fleet cannot keep pace
#                     with the gear it outgrows and ends up grinding in white kit.
#                     Applies to managed random bots only; human players are never affected.
#        Default:     2.0 - (double income)
#                     1.0 - (face value, no change)
#                     0.0 - (bots earn nothing)

Playerbot.GoldGainMultiplier = 2.0

#    Playerbot.GoldGainMultiplier.LowLevel
#        Description: The same multiplier, but for bots at or below
#                     Playerbot.GoldGainMultiplier.LowLevelMaxLevel. The early levels are
#                     where a bot is poorest in absolute terms and where each purchase -
#                     first bags, first real weapon, ammunition - costs a disproportionate
#                     share of everything it has ever earned, so the band is tuned higher.
#                     The band is chosen from the bot's CURRENT level, so a bot simply
#                     starts earning at the other rate when it levels out of the band.
#        Default:     2.0

Playerbot.GoldGainMultiplier.LowLevel = 2.0

#    Playerbot.GoldGainMultiplier.LowLevelMaxLevel
#        Description: Highest level that still counts as low-level for the multiplier above.
#                     At the default of 10, levels 1-10 use LowLevel and 11+ use
#                     Playerbot.GoldGainMultiplier. Set to 0 to disable the low band
#                     entirely and put every bot on the single multiplier.
#        Default:     10

Playerbot.GoldGainMultiplier.LowLevelMaxLevel = 10

#    Playerbot.Pve.AuctionPriceMultiplier
#        Description: Multiplies the anchor price a bot asks for an item it lists. Bots
#                     undercut the cheapest standing listing by 5% every pass, so with no
#                     multiplier the market walks itself down to the vendor floor within a
#                     few dozen passes and stays there. This is the headroom that race runs
#                     in: at 5% a pass, roughly forty-five undercuts are needed to work back
#                     down to the item's own unmultiplied value.
#                     Does not affect the vendor floor, which remains the hard bottom.
#        Default:     10.0
#                     1.0 - (price at the item's own computed value)

Playerbot.Pve.AuctionPriceMultiplier = 10.0

#    Playerbot.Pve.AuctionMinTradeGoodStack
#        Description: Smallest lot of a common material a bot will list. Capped by the
#                     item's own max stack size, so a material that stacks to 10 needs a
#                     full stack while one that stacks to 20 needs half.
#                     A single linen cloth is noise on the auction house: it burns a
#                     listing, and because the undercut ladder prices against the cheapest
#                     STANDING lot, it also drags the going rate down for every full stack
#                     already up there. Below the minimum the material is simply held, and
#                     the vendor pass still clears it if the pack gets tight.
#        Default:     5
#                     1 - (list any amount, the old behaviour)

Playerbot.Pve.AuctionMinTradeGoodStack = 5

#    Playerbot.Pve.AuctionValuableUnitCopper
#        Description: Per-unit vendor value at or above which a material is worth listing on
#                     its own, however few the bot holds, ignoring the minimum lot above.
#                     Calibrated against this realm's own prices: ordinary commodities top
#                     out around Mithril Bar at 400 copper a unit, while genuine single-item
#                     goods start at Black Lotus on 1000 - so 1000 is where the line sits.
#        Default:     1000 - (10 silver a unit)

Playerbot.Pve.AuctionValuableUnitCopper = 1000

#    Playerbot.Pve.AuctionVendorFloorFactor
#        Description: Multiple of an item's vendor price that a bot's auction ask never goes
#                     below. The same number is the threshold for listing at all: when the
#                     going market price is under this floor, the bot sells to a merchant
#                     instead of posting above what anyone is currently paying - which
#                     matters because an unsold bot lot is destroyed at expiry rather than
#                     returned, so a listing nobody meets costs the item AND the vendor money.
#                     Raising it makes bots hold out for a better price and vendor more
#                     readily; lowering it makes them list more and accept thinner margins.
#        Default:     1.5
#                     1.0 - (list at any price at or above vendor value)

Playerbot.Pve.AuctionVendorFloorFactor = 1.5

#    Playerbot.Pve.AuctionUndercutCopper
#        Description: How far a bot undercuts the cheapest standing lot, in copper PER UNIT.
#                     A flat step, not a percentage. A percentage compounds - 5% off a price
#                     that was itself 5% off walks a market down geometrically, and the
#                     further above vendor value the opening price sits the larger every
#                     early step is in absolute terms. A flat step drifts instead, at the
#                     same rate whatever the item is worth.
#                     Per unit because that is what the market comparison holds: a step
#                     defined on the lot total is not representable once the lot is divided
#                     back into a unit price, where integer division would swallow it. So a
#                     20-stack moves 20 copper a step at the default.
#        Default:     1

Playerbot.Pve.AuctionUndercutCopper = 1

#    Playerbot.Pve.Companion.FollowDistance
#        Description: Follow distance in yards for a companion trailing its master out of combat.
#        Default:     2.5

Playerbot.Pve.Companion.FollowDistance = 2.5

#    Playerbot.Pve.Companion.AssistRadius
#        Description: Maximum distance in yards at which a companion will pick up a fight:
#                     attackers of itself, its master or its group, and the master's active
#                     combat victim.
#        Default:     45

Playerbot.Pve.Companion.AssistRadius = 45

#    Playerbot.Pve.AutoReviveSeconds
#        Description: A dead bot first waits this long for a player resurrection (it accepts any
#                     pending resurrect request automatically). After the delay it releases,
#                     self-resurrects at 66% and - if it has a master - teleports back to them.
#        Default:     30

Playerbot.Pve.AutoReviveSeconds = 30

#    Playerbot.Pve.RestHealthPct
#    Playerbot.Pve.RestManaPct
#        Description: Out of combat, bots sit down to eat below the health threshold and drink
#                     below the mana threshold (the same free food/water the battleground
#                     preparation logic uses), resuming at ~99%.
#        Default:     60 / 50

Playerbot.Pve.RestHealthPct = 60
Playerbot.Pve.RestManaPct = 50

#    Playerbot.Pve.Tavern.*
#        Description: Bots drinking for FUN. A bot with nothing to heal, nothing to fight
#                     and nowhere to be occasionally buys a drink at the vendor price and
#                     works through it until it is smashed, then leaves the bottle alone
#                     for a while. Nothing here touches recovery: alcohol is kept out of
#                     the ration pool entirely (it restores nothing), and this never runs
#                     while the bot actually needs food or water.
#                     MinMinutes/MaxMinutes bound the wait between sessions, per bot.
#                     MaxDrunk is where a bot stops, 1-100; 100 is "completely smashed".
#        Default:     1 / 25 / 90 / 100
#                     Enable 0 - (bots stay sober)

Playerbot.Pve.Tavern.Enable = 1
Playerbot.Pve.Tavern.MinMinutes = 25
Playerbot.Pve.Tavern.MaxMinutes = 90
Playerbot.Pve.Tavern.MaxDrunk = 100

#    Playerbot.Pve.PlayerEngageMinHealthPct
#    Playerbot.Pve.PlayerEngageMinManaPct
#        Description: How healthy a bot must be before it STARTS a fight with a person -
#                     either by travelling to one it has not seen in a while, or by picking
#                     a nearby one it is not already fighting. Self-defence ignores this
#                     entirely: a bot that is attacked fights back at any health.
#                     These sit above the rest thresholds on purpose, and in zones where
#                     people can fight each other the rest pass tops bots up to these
#                     values rather than the rest ones, so they eat and drink to near-full
#                     instead of parking half-hurt between the two.
#        Default:     85 / 80

Playerbot.Pve.PlayerEngageMinHealthPct = 85
Playerbot.Pve.PlayerEngageMinManaPct = 80

#    Playerbot.Pve.AutoLearnSpellsOnLevelUp
#        Description: When a managed bot levels up, it learns every class-trainer spell it now
#                     qualifies for (free, rank chains included), so leveling bots keep a usable
#                     rotation without visiting trainers.
#        Default:     1 - (Enabled)

Playerbot.Pve.AutoLearnSpellsOnLevelUp = 1

#    Playerbot.PveGrind.Enable
#        Description: Idle managed random bots (online through Playerbot.RandomPopulation.*, not
#                     grouped with a human, not in a battleground or its queue) hunt nearby
#                     creatures, rest between kills and wander, gaining experience and levels.
#                     Battleground participation still wins: the queue sweep can pull grinding
#                     bots into a battleground whenever a human queues.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.PveGrind.Enable = 0

#    Playerbot.PveGrind.SearchRadius
#        Description: Radius in yards a grinding bot scans for its next creature target.
#        Default:     60

Playerbot.PveGrind.SearchRadius = 60

#    Playerbot.PveGrind.LevelMatchYards
#        Description: Yards of detour a bot accepts per level of mismatch when it
#                     picks something to grind. The level window elsewhere only says
#                     what is ALLOWED; picking purely by distance inside it had bots
#                     farming whatever was underfoot - grey mobs worth no experience
#                     at the bottom of a band, and fights they barely survive at the
#                     top. Zero restores pure nearest-wins.
#        Default:     15

Playerbot.PveGrind.LevelMatchYards = 15

#    Playerbot.PveGrind.WanderRadius
#        Description: When nothing attackable is nearby, the bot strolls to a random reachable
#                     point within this many yards every 12-25 seconds.
#        Default:     40

Playerbot.PveGrind.WanderRadius = 40

#    Playerbot.PveGrind.MaxLevelAbove
#    Playerbot.PveGrind.MaxLevelBelow
#        Description: Level window for grind targets relative to the bot's own level. Creatures
#                     more than MaxLevelAbove levels higher or MaxLevelBelow levels lower are
#                     ignored.
#        Default:     3 / 5

Playerbot.PveGrind.MaxLevelAbove = 3
Playerbot.PveGrind.MaxLevelBelow = 5

#    Playerbot.PveGrind.AllowElites
#        Description: Allow grinding bots to pull elite and world-boss creatures.
#        Default:     0 - (Disabled)

Playerbot.PveGrind.AllowElites = 0

#
#    Playerbot.Pve.DevilsaurHunt.Enable
#        Description: Let bots that SKIN hunt listed ELITES, on their own switch -
#                     AllowElites stays off. Despite the key's name the list is not
#                     only dinosaurs: it is whatever elite's skin the economy needs.
#                     A bot qualifies when its skinning covers the creature's level
#                     (5 x level, or (level - 10) x 10 under 20) and the creature is
#                     no more than MaxLevelsAbove over it; it looks SeekYards out
#                     for one. While fighting one it wears BuffSpell, and the blows
#                     between that bot and that creature ONLY are rescaled:
#                     DamageDonePct more dealt, and DamageTakenPct of its damage
#                     taken, multiplied ON TOP of the general creature-damage cut
#                     (both 50 = a quarter of stock). A player ganking the hunter
#                     fights it at normal strength.
#                     Read ONCE at startup - restart after changing these keys.
#                     BuffSpell must be a spell the server knows or the hunt stays off.
#        Default:     0 (Enable), "6498,6499,6500,3630,3631,3632,3633,3634,3641"
#                     (Entries - Un'Goro's devilsaurs plus the Barrens deviates, which
#                     are elite on classic data and normal on Wrath data), 0 (BuffSpell
#                     - needs a client Spell.dbc row; 90720 on Barracks+),
#                     100 (DamageDonePct), 50 (DamageTakenPct), 150 (SeekYards),
#                     3 (MaxLevelsAbove)
#
#    Playerbot.Pve.DevilsaurHunt.RouteChancePct
#        Description: How often a qualifying skinner's relocation picks a hunting
#                     ground in its own zone instead of an ordinary grind cluster.
#                     Seeking alone is not enough: the grind cache refuses elites, so
#                     nothing ever carried a bot within SeekYards of the game and the
#                     hunt produced nothing for days after it shipped. Never leaves
#                     the bot's home zone (or the zone it stands in, with banded
#                     rebirth off), so it chooses ground rather than migrating.
#                     0 disables the routing and leaves the hunt seek-only.
#        Default:     50
#
Playerbot.Pve.DevilsaurHunt.Enable = 0
Playerbot.Pve.DevilsaurHunt.Entries = "6498,6499,6500,3630,3631,3632,3633,3634,3641"
Playerbot.Pve.DevilsaurHunt.BuffSpell = 0
Playerbot.Pve.DevilsaurHunt.DamageDonePct = 100
Playerbot.Pve.DevilsaurHunt.DamageTakenPct = 50
Playerbot.Pve.DevilsaurHunt.SeekYards = 150
Playerbot.Pve.DevilsaurHunt.MaxLevelsAbove = 3
Playerbot.Pve.DevilsaurHunt.RouteChancePct = 50

#    Playerbot.Pve.CreatureDamageBonusPctInPvp
#        Description: Extra damage a bot deals to WILDLIFE while it is fighting a player
#                     and creatures at the same time, as a percentage added on top of
#                     100. 300 means such a bot hits creatures for four times the usual
#                     number until one side of the fight is over; 0 disables the rule.
#                     A bot jumped mid-pull otherwise loses to the pair - this lets it
#                     clear the adds and answer the person. Its damage TO the player is
#                     untouched, as is any bot that is only grinding, and the step adds
#                     to the per-extra-creature one rather than replacing it.
#                     Read ONCE at startup - restart after changing this key.
#        Default:     300

Playerbot.Pve.CreatureDamageBonusPctInPvp = 300

# The in-game command surface for PvE bots:
#   .playerbot pve summon <name>   - log a bot-account character in, teleport it to you and
#                                    join it to your group (it follows and assists from then on)
#   .playerbot pve dismiss [name]  - ungroup and log out the selected/named companion
#   .playerbot pve status          - PvE state of the selected bot
# Whisper commands a master can send their companion:
#   follow / stay / attack / passive / come / dismiss
#
# The auction house is populated by the bots themselves (AuctionSell / AuctionBuy below).
# There is no auction house bot in this fork: the core one has been removed.

#    Playerbot.Pve.Loot.Enable
#        Description: Bots loot gold and items from their own (or their group's) kills,
#                     walking to the corpse first.
#        Default:     1 - (Enabled)

Playerbot.Pve.Loot.Enable = 1

#    Playerbot.Pve.Vendor.Enable
#        Description: When bags run low (< 4 free slots) or any equipped item drops under 35%
#                     durability, autonomous bots walk to the nearest friendly vendor within
#                     200 yards, sell their grey items and repair (if the vendor can).
#        Default:     1 - (Enabled)

Playerbot.Pve.Vendor.Enable = 1

#    Playerbot.Pve.Quests.Enable
#        Description: Autonomous bots accept quests from nearby quest givers, prefer grind
#                     targets that advance their kill objectives, and turn completed quests in
#                     (choosing a usable reward). Kill-credit quests complete naturally;
#                     gathering/exploration objectives are not pursued yet.
#        Default:     1 - (Enabled)

Playerbot.Pve.Quests.Enable = 1

#    Playerbot.Pve.EquipUpgrades.Enable
#        Description: Bots equip looted or quest-rewarded weapons/armor when the item level
#                     beats what they are wearing (empty slots are always filled).
#        Default:     1 - (Enabled)

Playerbot.Pve.EquipUpgrades.Enable = 1

#    Playerbot.Pve.Buffs.Enable
#        Description: Out of combat, bots keep their class self-buffs up (Mark of the Wild,
#                     Power Word: Fortitude, Arcane Intellect, armors, aspects, Lightning
#                     Shield, ...) at real mana cost, gated above 60% mana so buffing never
#                     fights the eat/drink loop.
#        Default:     1 - (Enabled)

Playerbot.Pve.Buffs.Enable = 1

#    Playerbot.Pve.Talents.Enable
#        Description: Bots spend talent points as they level: each character deterministically
#                     picks one of its class's three signature specs (the same signatures the
#                     rotation engine detects) and greedily fills that tree tier by tier,
#                     overflowing into the others when capped. Safe against custom talent-tree
#                     rebuilds - selection keys on stable spell ids, not talent ids.
#        Default:     1 - (Enabled)

Playerbot.Pve.Talents.Enable = 1

#    Playerbot.PveGrind.Relocate.Enable
#        Description: When a grinding bot repeatedly finds nothing attackable (empty or
#                     outleveled area), the world-thread relocator teleports it to a random
#                     cluster of level-appropriate hostile spawns on the vanilla continents.
#                     Enemy-faction zones, water landings and spots near real players are
#                     rejected; the Z coordinate is grounded before the teleport.
#        Default:     1 - (Enabled)

Playerbot.PveGrind.Relocate.Enable = 1

#    Playerbot.PveGrind.Relocate.DryWandersBeforeMove
#        Description: How many consecutive fruitless wander cycles (no creature found within
#                     3x the search radius) trigger a relocation.
#        Default:     5

Playerbot.PveGrind.Relocate.DryWandersBeforeMove = 5

#    Playerbot.Pve.Quests.Enable also covers gameobject objectives: bots walk to and use
#    quest goobers (RequiredNpcOrGo credit) and loot quest chests within 120 yards of their
#    grind area. Gathering professions and exploration objectives remain unimplemented.

#    Playerbot.PveGrind.Relocate.Maps
#        Description: Comma-separated map ids the relocation cache samples grind spots from.
#                     Barracks+ keeps the vanilla continents; a wrath realm can use "0,1,530,571".
#                     The cache builds once at first use, so changes need a restart.
#        Default:     "0,1"

Playerbot.PveGrind.Relocate.Maps = "0,1"

#    Playerbot.PveGrind.StuckRecovery.Enable
#        Description: Safety net for autonomous open-world PvE bots. If a bot never reaches
#                     DistanceYards from an anchor during TimeoutSeconds, queue a world-thread
#                     teleport to a validated hostile-spawn cluster in the SAME zone.
#                     Combat, death, resting, casting/control, companions/stay orders,
#                     transports, flight, vehicles, battlegrounds and instances reset the
#                     observation window and never trigger recovery.
#        Default:     1 - (Enabled)

Playerbot.PveGrind.StuckRecovery.Enable = 1

#    Playerbot.PveGrind.StuckRecovery.DistanceYards
#        Description: Horizontal distance a bot must reach from its current anchor to count
#                     as meaningful progress and start a fresh observation window.
#        Default:     15.0

Playerbot.PveGrind.StuckRecovery.DistanceYards = 15.0

#    Playerbot.PveGrind.StuckRecovery.TimeoutSeconds
#        Description: Consecutive eligible seconds without reaching DistanceYards before the
#                     bot is recovered elsewhere in its current zone.
#        Default:     120

Playerbot.PveGrind.StuckRecovery.TimeoutSeconds = 120

#    Playerbot.Pve.Rest.UseConsumables
#        Description: Realm economy switch for bot recovery. 0 = bots cast the free eat/drink
#                     spells (Legionnaire+ style). 1 = bots buy real food/water (and ammo for
#                     ranged weapons) from vendors with their own gold and consume them, and an
#                     empty pantry triggers a vendor errand (Barracks+ style).
#        Default:     0

Playerbot.Pve.Rest.UseConsumables = 0

#    Playerbot.Pve.PvpOnlyAccountIds
#        Description: Comma-separated account ids whose bots are PvP-only: no PvE behavior of
#                     any kind (no grinding, errands, gear changes, talents or economy). They
#                     idle wherever they are parked - typically a sanctuary players cannot
#                     reach - and only answer the battleground orchestration, which returns
#                     them to that spot when the match ends. Empty disables the feature.
#        Default:     ""

Playerbot.Pve.PvpOnlyAccountIds = ""

#    Playerbot.Pve.DeclineGroupInvites
#        Description: Hardcore realms: bots never join groups. Group invites are declined and
#                     companion summons refused. 0 keeps the normal companion behavior.
#        Default:     0
Playerbot.Pve.DeclineGroupInvites = 0

#    Playerbot.OpenWorldNoFriendlyFire
#        Description: Managed playerbots are one team in the open world: they are never valid
#                     attack targets for each other outside battlegrounds and arenas, even when
#                     everyone is FFA-flagged on a hardcore realm. Battleground team rules are
#                     unaffected.
#        Default:     1
Playerbot.OpenWorldNoFriendlyFire = 1

#    Playerbot.Pve.AuctionSell.Enable
#        Description: Bots list the gear and goods they cannot use on their faction
#                     auction house, undercutting the cheapest standing listing of the
#                     same item by 5% but never going below vendor value. They never
#                     sell food, water, ammunition, bags, quest items or anything they
#                     would rather wear.
#        Default:     0
Playerbot.Pve.AuctionSell.Enable = 0

#    Playerbot.Pve.DeathChestAuctionHoldSeconds
#        Description: How long loot taken from a player's death chest is kept OFF the
#                     auction house. The bot keeps it, wears it and will list it in the
#                     end - this is only the window the owner has to run back and deal
#                     with the bot that has it. 0 lists it as soon as the bot gets round
#                     to it.
#        Default:     300 (5 minutes)

Playerbot.Pve.DeathChestAuctionHoldSeconds = 300

#    Playerbot.Pve.DeathChestAuctionReleaseSeconds
#        Description: Once the window above has passed, how long the fleet waits between
#                     posting one of that owner's pieces and the next. Counted per owner
#                     across every bot holding their things, so a nine piece chest goes up
#                     over nine minutes rather than in one breath, and there is always
#                     something left to buy back or whisper about. 0 posts them all at
#                     the first opportunity.
#        Default:     60 (one a minute)

Playerbot.Pve.DeathChestAuctionReleaseSeconds = 60


#    Playerbot.Pve.ZoneGuardians.PerZone
#        Description: This many bots per classic zone become that zone's permanent guardians:
#                     set to the zone's classic level cap, XP gain frozen, relocated only within
#                     their zone, excluded from rebirth and the reset command. Slots are claimed
#                     first-come each uptime (previous guardians re-claim first). 0 disables.
#        Default:     0
Playerbot.Pve.ZoneGuardians.PerZone = 0

#    Playerbot.Pve.Drifters.Count
#
#    Playerbot.Pve.Drifters.MaxPerZone
#        Description: Ceiling on how many drifters may be in any ONE zone,
#                     counted across everyone standing in it. The share is per
#                     person and the total is global, so without a cap five
#                     people in one zone draw five shares into it - which is the
#                     whole fleet arriving at once for anyone grinding there.
#                     Enforced in both directions: a full zone draws no more,
#                     and assignments over the ceiling are released, so lowering
#                     this takes effect on the next pass.
#        Default:     10
#                     0 - (no ceiling)
#
Playerbot.Pve.Drifters.MaxPerZone = 15

#    Playerbot.Pve.Drifters.ZoneDwellSeconds
#        Description: Drifters - bots drawn evenly out of the banded population that
#                     drift toward the people online, so the leveling world looks lived
#                     in wherever somebody actually is.
#
#                     Count is the total across the realm, split evenly between
#                     everyone online: thirty companions and three people online is
#                     ten each. They hold zone parity with the person they follow and
#                     are re-levelled into that zone's band on arrival, then grind
#                     there normally. Zero disables the feature.
#
#                     Zone guardians, the level-60 veterans and PvP-only bots are
#                     never drafted - they have no band home, which is exactly what
#                     makes them ineligible.
#
#                     ZoneDwellSeconds is how long a person must hold a zone before
#                     their drifters follow them into it - just long enough to
#                     ignore somebody running across a border and straight back.
#
#                     A flight path needs no help from that timer and gets none: a
#                     person in the air is not counted as being in the zones they
#                     pass over at all, so a cross-continent flight neither drags the
#                     retinue through six zones on the way nor releases it. The dwell
#                     starts from wherever they actually land.
#
#                     On a confirmed zone change the drifters are ported, levelled
#                     into the new zone's band, and given an auction sweep once they
#                     have arrived - the sweep waits for arrival so they shop for the
#                     character they are becoming, not the one they just left.
#
#                     A person in a capital, an instance or a battleground is not
#                     followed at all; their drifters stay where they were sent.
#        Default:     0 (disabled) / 10

Playerbot.Pve.Drifters.Count = 0
Playerbot.Pve.Drifters.ZoneDwellSeconds = 10

#
#    Playerbot.Pve.Drifters.TeleportGold
#        Description: Gold handed to a drifter every time it lands somewhere new.
#                     A landing runs in a fixed order: the bot sells its junk
#                     where it stands (no trip to a merchant) and lists its old
#                     gear on the auction house, THEN it is paid, THEN it shops
#                     the house - so it shops with room in its bags and money in
#                     its purse, for the character it has just become rather
#                     than the one it left.
#
#                     Counted in gold, not copper.
#
#                     Scaled by the level band of the zone it lands in:
#                     TeleportGold is what the lowest band pays (the 1-10 starter
#                     zones), TeleportGold.Max what the highest pays (55-60), and
#                     every band in between sits on the straight line through the
#                     two by its midpoint. A zone with no band pays TeleportGold.
#                     Max at or below TeleportGold pays TeleportGold flat; both 0
#                     pays nothing. The default is a flat 1g: a bigger stipend
#                     minted far more gold than the fleet earned (~245k g).
#        Default:     1 (TeleportGold), 1 (TeleportGold.Max)
#
Playerbot.Pve.Drifters.TeleportGold = 1
Playerbot.Pve.Drifters.TeleportGold.Max = 1

#    Playerbot.Pve.ProactiveMaxLevelsAbove
#        Description: How far above its own level a bot will PICK a fight with a person.
#                     Four is the orange/red boundary the client draws: a target five or
#                     more levels up is painted RED, which is the game's own way of
#                     saying you will lose, and a bot that walks into one is just
#                     donating a corpse. Everything up to and including orange is fair
#                     game.
#
#                     Self-defence ignores this completely - an attacked bot fights back
#                     however far above it the attacker is. Zero restores the old
#                     behaviour of never fighting uphill at all.
#        Default:     4

Playerbot.Pve.ProactiveMaxLevelsAbove = 4

#
#    Playerbot.Pve.ProactiveMaxLevelsBelow
#        Description: The floor under the rule above: how many levels BELOW a bot
#                     a player may be and still be picked on unprompted.
#
#                     The ceiling refuses a fight the bot would lose. This
#                     refuses one the bot cannot lose - being hunted by something
#                     you have no answer to is how a new character stops playing,
#                     and a zone guardian sitting at its post's ceiling was the
#                     worst of it.
#
#                     A player carrying enough BOUNTY is exempt: a bounty is earned
#                     by killing people, and the point of it is that the realm comes
#                     for you whatever you can handle. See
#                     Playerbot.Pve.ProactiveBountyStacks for how much is enough.
#
#                     Only governs STARTING a fight. Self-defence never consults
#                     this, so a bot still fights back at any level difference.
#                     0 disables the floor.
#        Default:     4
#

Playerbot.Pve.ProactiveMaxLevelsBelow = 4

#
#    Playerbot.Pve.ProactiveBountyStacks
#        Description: How many bounty stacks a player must carry before the level
#                     floor above stops protecting them. One stack is one kill,
#                     which is not yet somebody the realm should send a max-level
#                     guardian after; the waiver is meant for a person who has
#                     made a habit of it.
#
#                     Independent of Centurion.Bounty.GuardStacks, which is the
#                     much higher bar for summoning NPC guards.
#                     0 means no amount of bounty ever waives the floor.
#        Default:     5
#

Playerbot.Pve.ProactiveBountyStacks = 5

#
#    Playerbot.Pve.ResurrectGraceSeconds
#        Description: Seconds after a person resurrects in which no bot may START a
#                     fight with them. A wipe leaves a death chest on every body and
#                     the bots come to loot them, so without this a party revives
#                     among the bots that killed it and is killed again. Ends early
#                     if the person opens on a player first. Self-defence and fights
#                     already under way are unaffected. 0 disables it.
#        Default:     60
#

Playerbot.Pve.ResurrectGraceSeconds = 60


#    Playerbot.Pve.RebirthAtMaxLevel.Percent
#        Description: This percent of the managed fleet (guid-keyed, deterministic) is reborn
#                     on reaching the level cap: the full level-1 reset (gear, spells, talents,
#                     quests, money wiped; ported home) so the leveling world stays populated.
#                     PvP-only bots and companions are never reborn. 0 disables.
#        Default:     0
Playerbot.Pve.RebirthAtMaxLevel.Percent = 0

#    Playerbot.Pve.Rebirth.ZoneBanded
#        Description: Bots live inside one zone instead of climbing to the level cap. Each bot is
#                     permanently tied to a zone by its guid, and on reaching that zone's top
#                     level it is reborn at the zone's bottom level, so every band of content
#                     keeps a population at the level it was built for.
#                     A reborn bot KEEPS everything it owns - gear, bags, bank, money. Equipped
#                     items are moved into bags, since it can no longer wear them; anything that
#                     will not fit stays worn rather than being destroyed. Talents are refunded
#                     and re-spent automatically, quests are cleared, and spells above the new
#                     level are removed and re-taught by the trainer catch-up pass.
#                     Zone bands are derived from the levels of the creature clusters actually in
#                     each zone (20th and 80th percentile), not a hand-written table.
#                     When disabled, the old behaviour returns: Playerbot.Pve.RebirthAtMaxLevel
#                     .Percent of the fleet resets all the way to level 1 at the cap.
#        Default:     1 - (Enabled)

Playerbot.Pve.Rebirth.ZoneBanded = 1

#    Playerbot.Pve.Rebirth.Veterans
#        Description: Veterans are the bots that skip the zone cycle entirely, make the full
#                     climb to the level cap and stay there. Everything from level 55 up is
#                     left to them - Winterspring, Deadwind Pass and Silithus are not handed
#                     to banded bots, since the veterans already live in that content and two
#                     populations in the same zones would starve the ones below.
#                     This is a COUNT, not a share. It is drawn only from bots that actually
#                     cycle: zone guardians already sit at their zone's cap forever, and the
#                     PvP-only accounts are at the cap by definition, so both are excluded from
#                     the pool rather than counted against this number.
#        Default:     20

Playerbot.Pve.Rebirth.Veterans = 20

#    Playerbot.Pve.Rebirth.VeteranFleetSize
#        Description: The fleet size Playerbot.Pve.Rebirth.Veterans is turned into a share of.
#                     0 uses Playerbot.RandomPopulation.TargetMax. The share picks each bot's
#                     role by guid and the band homes are dealt out from the bots that are not
#                     veterans, so changing the fleet reshuffles both: bots that stop being
#                     veterans are band-reset on the spot, and most locals get new homes (and
#                     resets) at the next restart. Pin this to the current TargetMax before
#                     lowering the population target.
#        Default:     0 - (Use Playerbot.RandomPopulation.TargetMax)

Playerbot.Pve.Rebirth.VeteranFleetSize = 0

#    Playerbot.Pve.GuildName
#        Description: Guild every managed playerbot is put into. It is created around the first
#                     bot to need it, which becomes its guild master; every bot after that is
#                     simply added. Empty disables the whole behaviour and leaves bots
#                     guildless.
#        Default:     AI Uprising

Playerbot.Pve.GuildName = "AI Uprising"

#    Playerbot.Pve.Travel.WalkMaxDistance
#        Description: Relocations and town runs within this range are WALKED (segmented mmap
#                     pathing, fights allowed en route, stuck/timeout falls back to teleport).
#                     0 restores teleport-only travel.
#        Default:     900

Playerbot.Pve.Travel.WalkMaxDistance = 900

#    Playerbot.Pve.Travel.UseFlightPaths
#        Description: For longer travel, bots take real flight-master routes when the departure
#                     node is nearby and a route exists (BFS over taxi edges, up to 7 hops),
#                     paying the fare from their own gold. Teleport remains the last fallback.
#        Default:     1 - (Enabled)

Playerbot.Pve.Travel.UseFlightPaths = 1

#    Playerbot.Pve.AuctionBuy.Enable
#        Description: Bots browse their faction auction house every ~10 minutes and buy out one
#                     affordable gear upgrade (best item-level gain within budget), collect the
#                     win from their mailbox and equip it. A drifter also shops the moment
#                     it lands somewhere new, after selling and being paid.
#        Default:     0 - (Disabled)

Playerbot.Pve.AuctionBuy.Enable = 0

#    Playerbot.Pve.AuctionBuy.BudgetPct
#        Description: Maximum share of a bot's money a single auction buyout may cost.
#                     PER ITEM, and that is the only spending limit: a shopping trip
#                     keeps buying - one lot per equipment slot - until the purse
#                     cannot pay for the next one or nothing left on the house is
#                     worth having. The ceiling is fixed from the purse the trip
#                     started with, so a lot does not become dearer (in the item
#                     levels the scorer weighs it against) just because the bot has
#                     already bought something. A bot stripped bare ignores the
#                     share and may put everything into one lot.
#        Default:     30

Playerbot.Pve.AuctionBuy.BudgetPct = 30

#    Playerbot.Pve.AuctionBuy.MaxItemLevelsBehind
#        Description: How far BELOW a bot's own character level an auction's item
#                     level may sit before the bot will not consider it at all.
#
#                     A hard floor under AuctionLevelsBehindPenalty, which only
#                     makes stale gear score worse - and a penalty is a thumb on
#                     the scale, not a rule. Against an empty or nearly worthless
#                     slot a cheap scrap still wins, which is how level 40 bots
#                     ended up wearing level 10 gear.
#
#                     Nothing is capped on the way UP: gear above a bot's level
#                     is a fine thing to buy, and the core has already confirmed
#                     it can be worn. Bags and quivers are exempt - item level
#                     says nothing about a bag, slots do.
#        Default:     12
#                     0 - (No floor; the penalty alone decides)

Playerbot.Pve.AuctionBuy.MaxItemLevelsBehind = 12

#    Playerbot.Pve.AuctionBuy.MaxOverpayPct
#        Description: Ceiling on what a bot will ASK for a lot when it undercuts the house, as a
#                     percentage of the item's face value. This is NOT a purchase limit - bots
#                     will consider any listing at any price, and decide with the value test in
#                     BudgetWorthLevels, which penalises an overpriced listing smoothly instead
#                     of refusing it outright.
#                     It exists because the undercut anchor is the cheapest listing on the house
#                     including players', so without a cap one person listing a green for ten
#                     thousand gold walks the whole fleet's asking prices up to match.
#                     Keep it comfortably ABOVE Playerbot.Pve.AuctionPriceMultiplier x 100.
#                     0 disables it.
#        Default:     1200 - (12x face value; the sell multiplier is 10x)

Playerbot.Pve.AuctionBuy.MaxOverpayPct = 1200

#    Playerbot.Pve.AuctionBuy.BudgetWorthLevels
#        Description: How many item levels a bot considers its ENTIRE auction budget to be
#                     worth. Purchases are scored as (item levels gained) minus (price, in the
#                     same currency), and a bot only buys when that is positive - so an item
#                     costing half its budget must be worth half this many levels to be taken.
#                     Ranking on raw item-level gain alone made price a gate and nothing more:
#                     a bot would spend its whole purse on a single item level because that was
#                     the biggest number on the house. Cheapest-per-level is no better on its
#                     own - it buys a one copper trinket and never improves.
#                     Wealth scales this automatically: a rich bot pays real gold for a real
#                     upgrade, a poor one waits for a bargain.
#                     Lower to make bots stingier, raise to make them freer with gold.
#        Default:     15

Playerbot.Pve.AuctionBuy.BudgetWorthLevels = 15

#
#    Playerbot.Pve.GrantMounts
#        Description: Hand managed bots riding skill and a mount at level 40 and
#                     again at 60, without charging them for the training. Bots
#                     cannot visit a riding trainer or a mount vendor - the
#                     trainer catch-up only walks class trainers - so with this
#                     off they run the entire climb from 1 to 60 on foot.
#                     The mount is picked from the item table to suit the bot's
#                     race, and flying ranks are never granted.
#        Default:     1 (enabled)
#                     0 (disabled)
#
Playerbot.Pve.GrantMounts = 1

#
#    Playerbot.Pve.AggroBudget.Enable
#        Description: Cap how many bots may PROACTIVELY start a fight with one
#                     person at a time, sized by how much of their party is
#                     actually standing with them. Solo play stops being a
#                     dogpile and group play stops being trivial, without
#                     changing the population - the zone still looks as full as
#                     it did.
#                     Bots stay flagged and stay hostile; this decides only
#                     whether one chooses to pull. RETALIATION IS NEVER GATED:
#                     attacking a bot always gets you a fight, however many are
#                     already on you.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)
#
#
#    Playerbot.Pve.ProactiveHuntYards
#        Description: How close an ORDINARY bot must be before it will pick a
#                     fight with a person.
#                     Zone guardians are not affected - they keep
#                     Playerbot.Pve.ZoneGuardians.PlayerApproachYards, because
#                     holding a zone and noticing its visitors is the job, and
#                     because that value also has to stay above the 210 yard
#                     teleport landing distance to stop a just-dropped guardian
#                     from re-approaching forever.
#                     Lower this to give solo players room to grind; it does not
#                     reduce the bot population or how alive a zone looks.
#        Default:     125.0
#
Playerbot.Pve.ProactiveHuntYards = 125.0

Playerbot.Pve.AggroBudget.Enable = 0

#
#    Playerbot.Pve.AggroBudget.Solo
#        Description: Bots that may proactively engage one person who has nobody
#                     with them.
#        Default:     2
#
Playerbot.Pve.AggroBudget.Solo = 2

#
#    Playerbot.Pve.AggroBudget.PerExtraMember
#        Description: Added to the budget for each additional party member who is
#                     actually nearby. At the defaults a five-man in one place
#                     draws 10 where a lone player draws 2, so difficulty stays
#                     roughly flat across group sizes instead of inverting.
#        Default:     2
#
Playerbot.Pve.AggroBudget.PerExtraMember = 2

#
#    Playerbot.Pve.AggroBudget.MaxPerPlayer
#        Description: Ceiling on one person's budget, so a raid does not summon
#                     the whole fleet onto one target.
#        Default:     10
#
Playerbot.Pve.AggroBudget.MaxPerPlayer = 10

#
#    Playerbot.Pve.AggroBudget.PartyRadiusYards
#        Description: How close a party member must be to count toward the
#                     budget. A group spread across a continent is not five
#                     people helping you, and counting them would hand a solo
#                     player at the far end of a raid the whole fleet.
#        Default:     80.0
#
Playerbot.Pve.AggroBudget.PartyRadiusYards = 80.0

#    Playerbot.Pve.Professions.Enable
#        Description: Each bot takes two gathering professions (herbalism/mining/skinning,
#                     deterministic by character), learns and ranks them automatically, gathers
#                     herbs and ore it passes while grinding, skins its finished corpses, and
#                     sells the materials on vendor visits (unless a quest needs them).
#        Default:     0 - (Disabled)

Playerbot.Pve.Professions.Enable = 0

#
#    Playerbot.Pve.Professions.SmeltPercent
#        Description: What share of a miner's ore goes to the forge instead of to the
#                     auction house as raw ore. The bars come back to the bags and are
#                     listed by the ordinary trade-goods path, so the house carries
#                     copper, tin, silver, iron, gold, mithril, truesilver and thorium
#                     bars alongside the ore they were poured from.
#
#                     The same share is then applied to the bars themselves, which is
#                     what puts bronze (copper bar + tin bar) and steel (iron bar +
#                     coal) on the house next to their ingredients rather than instead
#                     of them. Coal is not mined: a bot short of it buys the shortfall
#                     out of its own purse at the merchant's asking price.
#
#                     Counted on the ore as it ARRIVES, not on what is in the bag, so
#                     the share means what it says however long a bot holds a stack.
#                     Requires Playerbot.Pve.Professions.Enable.
#        Default:     50
#                     0 - (Disabled: the fleet sells raw ore only)
#
Playerbot.Pve.Professions.SmeltPercent = 50

#
#    Playerbot.Pve.PathBudgetPerSecond
#        Description: Navmesh A* queries the whole bot fleet may issue per second.
#                     These run on the map-update thread that also resolves human
#                     combat, so this is really a cap on how much player-visible
#                     latency the bots are allowed to cause. Queries over budget
#                     are deferred, not dropped.
#        Default:     150
#
Playerbot.Pve.PathBudgetPerSecond = 150

#
#    Playerbot.PvpClassSpells.Range.*
#        Description: Engagement bands used by the class-spell engine, in yards.
#                     Melee is the band a melee bot closes to; Close is the short
#                     caster band; Spell and Long are the normal and extended
#                     nuke bands; Heal is the band a healer holds from its target.
#        Default:     8.0 / 15.0 / 30.0 / 35.0 / 40.0
#
Playerbot.PvpClassSpells.Range.Melee = 8.0
Playerbot.PvpClassSpells.Range.Close = 15.0
Playerbot.PvpClassSpells.Range.Spell = 30.0
Playerbot.PvpClassSpells.Range.Long = 35.0
Playerbot.PvpClassSpells.Range.Heal = 40.0

#
#    Centurion.Hardcore.FieldKit.GreyUntilLevel
#        Description: The starter field kit hands out grey gear below this level
#                     instead of white, so early upgrades still feel like upgrades.
#                     A slot with no grey option falls back to white.
#                     0 disables (always white).
#        Default:     15
#
Centurion.Hardcore.FieldKit.GreyUntilLevel = 15

#
#    Centurion.Hardcore.FieldKit.LevelOffset
#        Description: The field kit dresses the wearer as though they were this many
#                     levels lower, so the gear it issues is deliberately behind what
#                     the level could earn. The kit exists so a corpse run is not made
#                     naked; it is not meant to be gear worth keeping.
#                     The whole set shifts together - the wearer still gets the best
#                     piece available for the reduced level, not a patchy mix.
#                     The grey/white split still keys off the REAL level.
#                     0 disables (kit matches the wearer's own level).
#        Default:     10
#
Centurion.Hardcore.FieldKit.LevelOffset = 10

#
#    Centurion.Hardcore.FieldKit.BotLevelOffset
#        Description: The same idea for playerbots, held closer to their own level.
#                     A person who finds the kit thin can go and earn better gear;
#                     a bot cannot - it wears what the kit gives it for good, and
#                     ten levels down it stops being able to kill the things its
#                     own zone band is built around.
#        Default:     5
#
Centurion.Hardcore.FieldKit.BotLevelOffset = 5

#
#    Centurion.Hardcore.FieldKit.StaleLevels
#        Description: How far a worn kit piece may fall behind the level the kit
#                     now dresses for before it is replaced. The kit only fills
#                     EMPTY slots, so without this a piece issued at level 15 is
#                     still being worn at 50 - measured on the live fleet, worn kit
#                     averaged 18 levels behind its wearer and reached 41.
#        Default:     5
#
Centurion.Hardcore.FieldKit.StaleLevels = 5

#
#    Centurion.Hardcore.Diagnostics.MovementDivergenceYards
#        Description: Watches for a playerbot whose real position has drifted from
#                     the position its packets tell observers about. That gap is
#                     what a client draws as a bot standing somewhere it is not,
#                     and is the sporadic 'bot porting around' fault.
#
#                     Costs one distance check per bot every two seconds and logs
#                     nothing while they behave. Reports to playerbots.hardcore at
#                     ERROR level, rate limited to one line per bot per 30s.
#                     0 disables the watch.
#        Default:     6.0
#
Centurion.Hardcore.Diagnostics.MovementDivergenceYards = 6.0

#
#    Playerbot.Pve.ZoneGuardians.PlayerApproachYards
#        Description: How close a zone guardian tries to get to a real player. Guardians go
#                     to the people instead of waiting to be found: the server already
#                     knows where every player is, so this costs no searching - a snapshot
#                     of connected players is refreshed once a second on the world thread
#                     and read as a plain lookup.
#                     A guardian further than this from EVERY player is TELEPORTED to
#                     one, landing 120-180 yards away so it walks in from the edge of
#                     sight rather than materialising on top of anyone. Walking cannot
#                     cross a map, so a guardian whose zone is empty would otherwise
#                     never meet anybody at all.
#                     A guardian already this close also stops being leashed back to its
#                     own zone, so it can follow a fight out of the area.
#        Default:     200
#                     0   - (disabled: guardians stand their post and wait)
#
Playerbot.Pve.ZoneGuardians.PlayerApproachYards = 225

#
#    Playerbot.WhoListVisibility
#        Description: Whether playerbots appear in /who. They fill the list with names
#                     nobody can talk to, but on a realm where the bots ARE the
#                     population, hiding them makes the realm look empty.
#                     Tournament characters (Centurion.Tournament.Enable) are the one
#                     exception at every setting: bots queue in the world pool and live
#                     in zones a tournament character may not enter, so their /who is
#                     people-only unless they ask for bots by name with the keyword
#                     below.
#        Default:     1 - (only a GM in GM mode sees them)
#                     0 - (never listed)
#                     2 - (listed to everyone)
#
Playerbot.WhoListVisibility = 1

#    Playerbot.WhoListTag
#        Description: Shown in the guild column of the /who list for playerbots, so they can be
#                     told apart from real players at a glance. Bots are also always listed
#                     AFTER humans: the client is only sent 49 entries, so without that a fleet
#                     of bots buries every person in an unfiltered /who. Empty string disables
#                     the tag (ordering still applies).
#        Default:     <Bot>

Playerbot.WhoListTag = "<Bot>"

#    Playerbot.WhoHumanKeyword
#        Description: Type this as a /who search term to list ONLY real players - "/who humans"
#                     by default. The term is consumed, so it never also tries to match a name,
#                     guild or zone, and it combines with the rest of the window: "/who humans"
#                     with a level range or zone filter still applies those.
#                     There is no way to express NOT in the /who protocol and no command
#                     permission an ordinary player holds, so a reserved word is how this is
#                     offered without an addon.
#                     Empty disables it.
#        Default:     humans

Playerbot.WhoHumanKeyword = "humans,players"

#
#    Playerbot.WhoBotKeyword
#        Description: Comma-separated search words that make /who list ONLY
#                     playerbots, e.g. /who bots. The word is consumed, so it is
#                     never also matched against a name, guild or zone.
#                     This does not override Playerbot.WhoListVisibility: on a
#                     realm that hides bots from ordinary players, asking for them
#                     by name still returns nothing.
#        Default:     "bots,playerbots"
#
Playerbot.WhoBotKeyword = "bots,playerbots"

#
#    Playerbot.Pve.ZoneGuardians.EscalateAfterMinutes
#        Description: Minutes a guardian may go without fighting an actual player before
#                     it starts landing closer. Teleports normally drop at 210 yards -
#                     outside the 200 yard sight range, so the port is never witnessed
#                     and the guardian walks in over the horizon. Past this many idle
#                     minutes the drop closes by six yards a minute, down to twenty,
#                     until it is arriving on top of them.
#                     Any fight with a real player resets the clock, so an active
#                     guardian never escalates - only a bored one does.
#        Default:     30
#                     0 - (escalate immediately)
#
Playerbot.Pve.ZoneGuardians.EscalateAfterMinutes = 30

#
#    Playerbot.Pve.Aggression.MinMinutes
#    Playerbot.Pve.Aggression.MaxMinutes
#        Description: Every bot carries an aggression score of 1-100. It is derived from
#                     the character GUID, so it is stable for the life of that character,
#                     survives restarts and costs no storage - and two bots of the same
#                     class are still different people.
#                     The distribution is a bell, not a flat roll, centred on a mean that
#                     depends on class: rogue 75, death knight 72, warrior 70, paladin 60,
#                     hunter 58, shaman 55, druid 50, warlock 45, mage 40, priest 35, with
#                     a spread of about 15 either side. Most of a class sits near its
#                     temperament and the extremes are rare, so a fleet reads as a
#                     population rather than as noise.
#                     The score decides how long that bot tolerates not fighting a person
#                     before it travels to one and starts something: 100 waits MinMinutes,
#                     1 waits MaxMinutes. At the defaults a median rogue goes hunting after
#                     about 27 minutes and a median priest after about 61.
#                     Travel uses the same teleport as the zone guardians - dropped at 210
#                     yards, outside sight, so it walks in rather than appearing.
#        Default:     5 / 90
#                     MaxMinutes 0 disables the hunt for ordinary bots and leaves it to
#                     the zone guardians.
#
Playerbot.Pve.Aggression.MinMinutes = 5
Playerbot.Pve.Aggression.MaxMinutes = 90

#    Playerbot.Pve.Aggression.TimidMinutes
#        Description: How long a bot stays out of trouble after being killed while fighting a
#                     person. While timid it will not go looking for a fight, a zone guardian
#                     will not close in, and on resurrection it relocates to a grind spot with
#                     nobody near it instead of walking back to its corpse. Scaled by the bot's
#                     own aggression: the bravest serve half this, the meekest twice.
#                     0 disables timidity entirely.
#        Default:     20

Playerbot.Pve.Aggression.TimidMinutes = 20

#    Playerbot.Pve.Aggression.TimidFleeYards
#        Description: How far a fleeing bot's new grind spot must be from the nearest person.
#                     The retreat stays inside the bot's own zone (a guardian's post). If the
#                     zone is busy enough that nowhere in it is this clear, the bot skips the
#                     move and stays where it is - it is still timid either way, so it grinds
#                     in place rather than teleporting across a crowded zone for nothing.
#        Default:     500

Playerbot.Pve.Aggression.TimidFleeYards = 500

#    Playerbot.Pve.TransientBountyHunters.Enable
#        Description: Answers the bounty's PvP-bot rung (Centurion.Bounty.PvpBotStacks) with
#                     transient copies of the characters on Playerbot.Pve.PvpOnlyAccountIds
#                     instead of logged-in bots, which never exist on a realm that keeps those
#                     characters offline. Each copy appears out of sight of the bountied player,
#                     walks to them and fights them. Creatures and the copy ignore each other,
#                     it dies like anyone (death chest included) and it is gone once the hunt
#                     is over: its quarry died, left, lost the bounty or reached a sanctuary,
#                     an arena or an instance. Needs Playerbot.Pve.Enable, Centurion.Bounty.Enable,
#                     and Playerbot.Enable with the PvP class spells for the copies to fight.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbot.Pve.TransientBountyHunters.Enable = 0

#    Playerbot.Pve.TransientBountyHunters.MaxTotal
#        Description: How many of those copies may exist at once, realm-wide. Per player the
#                     bounty's own ceiling applies (Bounty MaxHuntersOnTarget), and nothing new
#                     is sent while the resource governor reports hard pressure.
#        Default:     12

Playerbot.Pve.TransientBountyHunters.MaxTotal = 12
